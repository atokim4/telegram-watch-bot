# Copy to .env and fill in. Everything except the bot token is optional.

# From @BotFather (needed for the bot; `tgwatch check` works without it)
TELEGRAM_BOT_TOKEN=
# Leave empty for api.telegram.org; set it to use a local Bot API server
TELEGRAM_API_BASE=
# Telegram user ids allowed to use /stats, as a JSON list: [123456789]
ADMIN_CHAT_IDS=[]

# Optional AI relevance filter. Empty = keyword filter only.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

DATABASE_PATH=data/tgwatch.sqlite3
MAX_WATCHES_PER_CHAT=10
DEFAULT_INTERVAL_MINUTES=15
# Seconds between two dry runs (/test, new watch) in one chat
PREVIEW_COOLDOWN_SECONDS=10

# Sent with every request. Add a contact URL if you run a public instance.
USER_AGENT=
HTTP_TIMEOUT_SECONDS=20
HOST_MIN_INTERVAL_SECONDS=2
RESPECT_ROBOTS_TXT=true
# Keep false for a bot other people can use (blocks localhost/LAN/cloud metadata URLs)
ALLOW_PRIVATE_HOSTS=false
